# Use a dedicated OIDC application for the ENTITY API. Login and MFA happen at the provider.
ENTITY_OIDC_ISSUER=https://identity.example.com/
ENTITY_OIDC_AUDIENCE=entity-api
ENTITY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# PostgreSQL is required. SQLite is deliberately unsupported for access control/session state.
ENTITY_DATABASE_URL=postgresql+psycopg://entity@localhost:5432/entity
ENTITY_ENVIRONMENT=development

# Generate a unique random key outside the repository and store it in your secret manager.
ENTITY_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
ENTITY_MFA_AMR_VALUES=mfa,otp,hwk
ENTITY_PRIVILEGED_MAX_RANK=3
ENTITY_STEP_UP_MAX_AGE_SECONDS=300
ENTITY_JWKS_TIMEOUT_SECONDS=5

# Staging/production: dedicated workload identity allowed to publish server-side resource policy.
# Configure both values; leave both blank in local development and tests.
ENTITY_RESOURCE_REGISTRY_AUDIENCE=
ENTITY_RESOURCE_REGISTRY_SUBJECTS=

# Pin the exact OIDC subject only through the controlled Owner bootstrap and deployment process.
# Do not use the founder's public name or birthplace as proof of identity.
ENTITY_ORIGINAL_OWNER_SUBJECT=
# Required only when running the one-time bootstrap; this must be a separately verified reviewer.
ENTITY_ORIGINAL_OWNER_BOOTSTRAP_REVIEWER_SUBJECT=

# Optional staging smoke verifier inputs. Supply tokens only from a secret manager.
# Do not commit filled values. Run: python -m entity_auth.staging
ENTITY_STAGING_BASE_URL=
ENTITY_STAGING_OWNER_SUBJECT=
ENTITY_STAGING_OWNER_TOKEN=
ENTITY_STAGING_REGISTRY_TOKEN=
